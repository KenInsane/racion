rules_version = '2';
// Доступ к общему списку есть только у того, кто знает его ключ (он в ссылке-приглашении).
// Перечислить чужие списки нельзя: на households разрешено только get, без list.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{hid} {
      allow get, create, update: if request.auth != null && hid.size() >= 16;

      match /state/{doc} {
        allow read, write: if request.auth != null && hid.size() >= 16;
      }

      match /expenses/{id} {
        allow read, delete: if request.auth != null && hid.size() >= 16;
        allow create, update: if request.auth != null && hid.size() >= 16
          && request.resource.data.amount is number
          && request.resource.data.amount > 0 && request.resource.data.amount < 5000
          && request.resource.data.date is string && request.resource.data.date.size() == 10;
      }
    }
  }
}
